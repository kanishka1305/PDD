<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Top Spacer -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Green Success Ring -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/circle_bg"
        android:backgroundTint="#193024"
        android:gravity="center">

        <!-- Checkmark icon using profile drawable -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/profile"
            app:tint="#30D158"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Analysis Complete"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your diagnostic report is ready"
        android:textColor="#8E8E93"
        android:textSize="16sp"
        android:layout_marginTop="10dp"/>

    <!-- Options Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp">

        <!-- Diagnostic Report (DCM/STL) Option -->
        <LinearLayout
            android:id="@+id/btnViewReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_dark_bg"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/icon_dark_bg"
                android:gravity="center">

                <!-- Download icon using rotation of upload -->
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/upload"
                    android:rotation="180"
                    app:tint="#0A84FF"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DCM/STL"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="17sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full diagnostic report with measurements"
                    android:textColor="#8E8E93"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Export STL for 3D Printing Option -->
        <LinearLayout
            android:id="@+id/btnExportStl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_dark_bg"
            android:orientation="horizontal"
            android:padding="20dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/icon_dark_bg"
                android:gravity="center">

                <!-- Settings icon as placeholder for 3D box -->
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/settings"
                    app:tint="#0A84FF"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export STL for 3D Printing"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="17sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3D model file for surgical guides"
                    android:textColor="#8E8E93"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Share with Clinic Option -->
        <LinearLayout
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_dark_bg"
            android:orientation="horizontal"
            android:padding="20dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/icon_dark_bg"
                android:gravity="center">

                <!-- Share icon using upload -->
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/upload"
                    app:tint="#0A84FF"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share with Clinic"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="17sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send secure link to colleagues"
                    android:textColor="#8E8E93"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"/>

    <!-- Back to Command Center -->
    <LinearLayout
        android:id="@+id/btnBackCommandCenter"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/button_outline_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/back__1_"
            app:tint="#0A84FF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back to Command Center"
            android:textColor="#0A84FF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginStart="10dp"/>
    </LinearLayout>

    <!-- Footer Report Label -->
    <TextView
        android:id="@+id/txtReportFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Report ID: RPT-2024-001-A3F2  •  Generated Jan 20, 2024"
        android:textColor="#555555"
        android:textSize="11sp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="10dp"/>

</LinearLayout>
