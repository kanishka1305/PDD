<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/back__1_"
                app:tint="#0A84FF"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terms of Service"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="26sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Effective date: January 1, 2024"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/document"
                app:tint="#0A84FF"/>
        </LinearLayout>

        <!-- Intro Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/edit_bg"
            android:padding="18dp"
            android:layout_marginTop="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please read these Terms of Service carefully before using DentAI Segment. By using our platform, you agree to be bound by these terms and our Privacy Policy."
                android:textColor="#F5D28A"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"/>
        </LinearLayout>

        <!-- Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acceptance of Terms"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginTop="34dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="By accessing and using DentAI Segment, you accept and agree to be bound by these Terms of Service. If you do not agree to these terms, you may not use our services."
            android:textColor="#B0B0B0"
            android:textSize="15sp"
            android:lineSpacingExtra="7dp"
            android:layout_marginTop="14dp"/>

        <!-- Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service Description"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginTop="34dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DentAI Segment provides AI-powered dental imaging analysis tools for professionals. Our platform uses machine learning algorithms to assist in the segmentation and analysis of CBCT scans and other dental imaging modalities."
            android:textColor="#B0B0B0"
            android:textSize="15sp"
            android:lineSpacingExtra="7dp"
            android:layout_marginTop="14dp"/>

        <!-- Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Responsibilities"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginTop="34dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Users are responsible for maintaining the confidentiality of their account credentials and ensuring that all uploaded data complies with applicable laws and regulations."
            android:textColor="#B0B0B0"
            android:textSize="15sp"
            android:lineSpacingExtra="7dp"
            android:layout_marginTop="14dp"/>

        <!-- Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Limitation of Liability"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginTop="34dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DentAI Segment shall not be liable for any indirect, incidental, or consequential damages arising from the use or inability to use our services."
            android:textColor="#B0B0B0"
            android:textSize="15sp"
            android:lineSpacingExtra="7dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="40dp"/>

    </LinearLayout>

</ScrollView>